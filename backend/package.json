    "@types/node": "20.11.30",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.8",
    "fast-check": "3.17.2",
    "jest": "29.7.0",
    "nodemon": "3.1.0",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "typescript": "5.4.3"
